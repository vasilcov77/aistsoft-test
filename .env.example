# App
APP_NAME=test
USER_ID=1000
GROUP_ID=1000

# Valkey (в docker — имя сервиса, с хоста — localhost:6379)
REDIS_ADDR=valkey:6379
REDIS_PASSWORD=secret

# Ключ checko API. Реальное значение — только в .env (файл не коммитится)
TOKEN=

# Необязательные настройки (значения по умолчанию)
