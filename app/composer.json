{
    "name": "aistsoft/checko-api",
    "description": "REST API wrapper around checko.ru without a framework",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-redis": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.13",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
