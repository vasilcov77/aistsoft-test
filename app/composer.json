{
    "name": "aistsoft/checko-api",
    "description": "REST API wrapper around checko.ru without a framework",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-redis": "*",
        "guzzlehttp/guzzle": "^7.9",
        "psr/simple-cache": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Checko\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Checko\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
